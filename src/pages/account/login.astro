---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  accountsEnabled,
  requestLogin,
  isValidEmail,
  getCustomerEmail,
} from '../../features/auth/customer';
import { verifyConfiguredTurnstile, TURNSTILE_FIELD } from '../../features/auth/turnstile';
import { getSecret } from '../../features/secrets/store';
import Turnstile from '../../features/auth/Turnstile.astro';

if (!(await accountsEnabled())) return Astro.redirect('/', 303);
// Already signed in → account.
if (await getCustomerEmail(Astro.cookies)) return Astro.redirect('/account', 303);

let sent = false;
let error = Astro.url.searchParams.get('error') === 'expired' ? 'Este enlace ha cadudado — solicita uno nuevo.' : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  // Bot challenge (if enabled in Settings → Bot protection): verify with the vault secret.
  const turnstileEnabled = Astro.locals.settings?.turnstileEnabled === true;
  const tsSecret = turnstileEnabled
    ? await getSecret(env.DB, 'turnstile_secret_key')
    : null;
  const tsOk = await verifyConfiguredTurnstile(
    turnstileEnabled,
    form.get(TURNSTILE_FIELD)?.toString(),
    tsSecret,
    Astro.request.headers.get('CF-Connecting-IP'),
  );
  if (!tsOk) {
    error = 'Verificación fallida — por favor, prueba otra vez.';
  } else if (!isValidEmail(email)) {
    error = 'Escribe una dirección de email válida.';
  } else {
    await requestLogin(email, Astro.url.origin);
    sent = true;
  }
}
---

<Layout title="Entrar">
  <div class="mx-auto max-w-sm py-10">
    <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">Entra</h1>

    {
      sent ? (
        <p class="rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
          Comprueba tu email — te va a llegar un enlace de entrada directa. Caduca en 15 minutos. Revisa la carpeta SPAM
        </p>
      ) : (
        <Fragment>
          <p class="mb-5 text-sm text-muted">
            Introduce tu email y te llegará un enlace de entrada directa — no necesitas contraseña. Usa la dirección
            desde tus pedidos para ver tu historial de pedidos.
          </p>
          {error && (
            <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
              {error}
            </p>
          )}
          <form method="POST" class="space-y-3">
            <input
              type="email"
              name="email"
              required
              autofocus
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full rounded-md border border-line px-3 py-2"
            />
            <div class="flex justify-center">
              <Turnstile />
            </div>
            <button
              type="submit"
              class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
            >
              Enviar enlace
            </button>
          </form>
        </Fragment>
      )
    }
  </div>
</Layout>
