---
import { getConfig, formatPrice } from '../../../config';
import type { PendingPayment } from '../lightning/pending';

interface Props {
  pending: PendingPayment;
  declined?: string | null;
}
const { pending, declined = null } = Astro.props;

const { storeName } = getConfig();
const total = formatPrice(pending.amount_total_cents, pending.currency);
const shipping = pending.shipping_cents
  ? formatPrice(pending.shipping_cents, pending.currency)
  : null;

type Snap = { id: number; q: number; n: string; p: number };
let items: Snap[] = [];
try {
  items = pending.items ? (JSON.parse(pending.items) as Snap[]) : [];
} catch {
  items = [];
}
---

<div class="mx-auto max-w-md">
  <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">Finalizar pedido</h1>
  <p class="mb-6 text-sm text-muted">{storeName}</p>

  <!-- Resumen del pedido -->
  <div class="mb-6 rounded-lg border border-line bg-surface p-4">
    <ul class="divide-y divide-line text-sm">
      {items.map((it) => (
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="min-w-0 truncate">
            {it.n} <span class="text-faint">× {it.q}</span>
          </span>
          <span class="shrink-0 tabular-nums">{formatPrice(it.p * it.q, pending.currency)}</span>
        </li>
      ))}
    </ul>
    {shipping && (
      <div class="flex items-center justify-between border-t border-line pt-2 text-sm text-muted">
        <span>Envío</span>
        <span class="tabular-nums">{shipping}</span>
      </div>
    )}
    <div class="mt-2 flex items-center justify-between border-t border-line pt-2 text-base font-medium">
      <span>Total</span>
      <span class="tabular-nums">{total}</span>
    </div>
  </div>

  {declined && (
    <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
      {declined}
    </p>
  )}

  <form id="checkout-form" method="POST" class="space-y-4">
    <!-- Email -->
    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="email">
        Correo para la confirmación del pedido
      </label>
      <input
        id="email"
        name="email"
        type="email"
        value={pending.email ?? ''}
        autocomplete="email"
        required
        class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
    </div>

    <!-- Datos de envío -->
    <fieldset class="rounded-lg border border-line p-3 space-y-3">
      <legend class="px-1 text-xs font-medium text-muted">Datos de envío</legend>
      
      <div>
        <label class="mb-1 block text-xs font-medium text-muted" for="fullName">Nombre completo</label>
        <input
          id="fullName"
          name="fullName"
          type="text"
          required
          class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
        />
      </div>

      <div>
        <label class="mb-1 block text-xs font-medium text-muted" for="address">Dirección</label>
        <input
          id="address"
          name="address"
          type="text"
          required
          class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
        />
      </div>

      <div class="flex gap-2">
        <div class="w-1/2">
          <label class="mb-1 block text-xs font-medium text-muted" for="city">Ciudad</label>
          <input
            id="city"
            name="city"
            type="text"
            required
            class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
          />
        </div>
        <div class="w-1/2">
          <label class="mb-1 block text-xs font-medium text-muted" for="postalCode">Código postal</label>
          <input
            id="postalCode"
            name="postalCode"
            type="text"
            required
            class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label class="mb-1 block text-xs font-medium text-muted" for="country">País</label>
        <input
          id="country"
          name="country"
          type="text"
          required
          value="España"
          class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
        />
      </div>
    </fieldset>

    <!-- Botón de pago -->
    <button
      type="submit"
      class="w-full rounded-md bg-brand px-5 py-3 text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover"
    >
      Pagar desde PayPal
    </button>
    <a href="/cart" class="block text-center text-xs uppercase tracking-widest text-faint hover:text-brand">
      Cancelar
    </a>
  </form>
</div>

<script>
  // Envío asíncrono para guardar datos y luego redirigir a PayPal
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('checkout-form');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch(window.location.href, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          // Redirigir a PayPal después de guardar los datos
          window.location.href = 'https://pay.jim88.de';
        } else {
          alert('Hubo un problema al guardar los datos. Por favor, inténtalo de nuevo.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error de conexión. Inténtalo de nuevo.');
      }
    });
  });
</script>
