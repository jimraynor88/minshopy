---
import { getConfig, formatPrice } from '../../../config';
import type { PendingPayment } from '../lightning/pending';

interface Props {
  pending: PendingPayment;
  declined?: string | null;
}
const { pending, declined = null } = Astro.props;

const { storeName } = getConfig();
const total = formatPrice(pending.amount_total_cents, pending.currency);
const shipping = pending.shipping_cents
  ? formatPrice(pending.shipping_cents, pending.currency)
  : null;

type Snap = { id: number; q: number; n: string; p: number };
let items: Snap[] = [];
try {
  items = pending.items ? (JSON.parse(pending.items) as Snap[]) : [];
} catch {
  items = [];
}

let shipAddress: {
  name?: string; line1?: string; line2?: string;
  city?: string; state?: string; postal?: string; country?: string;
} | null = null;
try {
  shipAddress = pending.ship_address ? JSON.parse(pending.ship_address) : null;
} catch {
  shipAddress = null;
}
---

<div class="mx-auto max-w-md">
  <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">Finalizar pedido</h1>

  <!-- Resumen del pedido -->
  <div class="mb-6 rounded-lg border border-line bg-surface p-4">
    <ul class="divide-y divide-line text-sm">
      {items.map((it) => (
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="min-w-0 truncate">
            {it.n} <span class="text-faint">× {it.q}</span>
          </span>
          <span class="shrink-0 tabular-nums">{formatPrice(it.p * it.q, pending.currency)}</span>
        </li>
      ))}
    </ul>
    {shipping && (
      <div class="flex items-center justify-between border-t border-line pt-2 text-sm text-muted">
        <span>Envío</span>
        <span class="tabular-nums">{shipping}</span>
      </div>
    )}
    <div class="mt-2 flex items-center justify-between border-t border-line pt-2 text-base font-medium">
      <span>Total</span>
      <span class="tabular-nums">{total}</span>
    </div>
  </div>

  <!-- Dirección de envío -->
  {shipAddress && (
    <div class="mb-6 rounded-lg border border-line bg-surface p-4 text-sm">
      <div class="mb-1 font-medium">Dirección de envío</div>
      <div class="text-muted space-y-0.5">
        {shipAddress.name && <div>{shipAddress.name}</div>}
        {shipAddress.line1 && (
          <div>{shipAddress.line1}{shipAddress.line2 ? `, ${shipAddress.line2}` : ''}</div>
        )}
        {(shipAddress.city || shipAddress.postal) && (
          <div>
            {[shipAddress.postal, shipAddress.city].filter(Boolean).join(' ')}
            {shipAddress.state ? `, ${shipAddress.state}` : ''}
          </div>
        )}
        {shipAddress.country && <div>{shipAddress.country}</div>}
      </div>
    </div>
  )}

  {declined && (
    <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
      {declined}
    </p>
  )}

  <!-- Instrucciones -->
  <div class="mb-6 rounded-lg border-2 border-amber-400 bg-amber-50 px-4 py-4 text-sm text-amber-900">
    <p class="font-semibold mb-2">Cómo pagar con PayPal:</p>
    <ol class="list-decimal list-inside space-y-1">
      <li>Haz clic en <strong>"Pagar con PayPal"</strong> — se abre en pestaña nueva.</li>
      <li>Introduce el importe <strong>{total}</strong> y completa el pago.</li>
      <li>Añade tu email en la nota de PayPal para asociar el pedido.</li>
      <li>Vuelve aquí y pulsa <strong>"Confirmar pedido"</strong>.</li>
    </ol>
  </div>

  <form method="POST" class="space-y-4">
    <!-- outcome fijo: registra el pedido al confirmar -->
    <input type="hidden" name="outcome" value="approve" />

    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="email">
        Email para la confirmación del pedido
      </label>
      <input
        id="email"
        name="email"
        type="email"
        value={pending.email ?? ''}
        autocomplete="email"
        required
        placeholder="tu@email.com"
        class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
    </div>

    <!-- Enlace PayPal (abre pestaña nueva, NO envía el formulario) -->
    <a
      href="https://pay.jim88.de"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full rounded-md bg-[#009cde] border-2 border-[#003087] px-5 py-3 text-center text-sm font-semibold text-white hover:bg-[#003087] transition-colors"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.315 2.6 1.073 4.687-.017.115-.017.234-.017.35-.338 3.44-2.304 5.48-5.773 5.48H11.69c-.37 0-.683.27-.74.633L9.98 18.68c-.054.35-.353.63-.703.63H7.076zm7.477-14.307h-2.15l-1.162 7.87h2.15c2.96 0 4.52-1.44 4.81-4.39.195-1.685-.022-2.81-.667-3.547-.16-.184-.362-.33-.98-.333z"/>
      </svg>
      Pagar {total} con PayPal
    </a>

    <!-- Botón de confirmación (envía el POST que registra el pedido) -->
    <button
      type="submit"
      class="w-full rounded-md bg-brand px-5 py-3 text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover"
    >
      ✓ He pagado — Confirmar pedido
    </button>

    <a href="/cart" class="block text-center text-xs uppercase tracking-widest text-faint hover:text-brand">
      Cancelar
    </a>
  </form>
</div>
